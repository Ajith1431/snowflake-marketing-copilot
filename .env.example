# Campaign Intelligence Platform :: Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your actual credentials.
#     cp .env.example .env
# NEVER commit .env to version control.
# ============================================================================

# --- Snowflake ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=              # <-- fill in your password
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=

# --- Application Auth ---
APP_USERNAME=
APP_PASSWORD=

# --- Event Intelligence (src/intelligence) ---
# Get your key from https://eventregistry.org
EVENT_REGISTRY_API_KEY=
NEWS_API_KEY=                    # optional
SNOWFLAKE_CONNECTION=            # optional; name in ~/.snowflake/connections.toml

# --- Server Settings ---
API_PORT=8000
API_HOST=127.0.0.1
LOG_LEVEL=INFO

# --- Frontend API Target ---
# The Streamlit frontend will call this URL
API_BASE_URL=http://127.0.0.1:8000
API_TIMEOUT=30
